                <component
                  refId="Package\Nap bang su kien\Nap FactQualifying\Nguon FactQualifying"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Nguon FactQualifying"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH q AS (
    SELECT qualifyId, raceId, driverId, constructorId, position,
           F1_DWH.dbo.fn_DoiThoiGianSangMs(q1) AS Q1Ms,
           F1_DWH.dbo.fn_DoiThoiGianSangMs(q2) AS Q2Ms,
           F1_DWH.dbo.fn_DoiThoiGianSangMs(q3) AS Q3Ms
    FROM dbo.qualifying)
SELECT CAST(q.qualifyId AS INT) AS QualifyID,
       CAST(YEAR(ra.[date]) * 10000 + MONTH(ra.[date]) * 100 + DAY(ra.[date]) AS INT) AS DateKey,
       dr.RaceKey, dc.CircuitKey, dd.DriverKey, dk.ConstructorKey,
       CAST(q.position AS INT) AS QualiPosition,
       q.Q1Ms, q.Q2Ms, q.Q3Ms,
       (SELECT MIN(v) FROM (VALUES (q.Q1Ms), (q.Q2Ms), (q.Q3Ms)) AS t(v)) AS BestLapMs
FROM q
JOIN dbo.races ra                 ON ra.raceId        = q.raceId
JOIN F1_DWH.dbo.DimRace dr        ON dr.RaceID        = q.raceId
JOIN F1_DWH.dbo.DimCircuit dc     ON dc.CircuitID     = ra.circuitId
JOIN F1_DWH.dbo.DimDriver dd      ON dd.DriverID      = q.driverId
JOIN F1_DWH.dbo.DimConstructor dk ON dk.ConstructorID = q.constructorId</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
                      description="Specifies the column code page to use when code page information is unavailable from the data source."
