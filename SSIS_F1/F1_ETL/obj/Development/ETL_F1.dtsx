                <component
                  refId="Package\Nap bang su kien\Nap FactRaceResult\Nguon FactRaceResult"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Nguon FactRaceResult"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">-- Tra khoá thay thế (…Key) từ các bảng chiều của F1_DWH theo mã gốc (…ID)
SELECT CAST(r.resultId AS INT) AS ResultID,
       CAST(YEAR(ra.[date]) * 10000 + MONTH(ra.[date]) * 100 + DAY(ra.[date]) AS INT) AS DateKey,
       dr.RaceKey, dc.CircuitKey, dd.DriverKey, dk.ConstructorKey, ds.StatusKey,
       CAST(r.grid AS INT) AS GridPosition,
       CAST(r.position AS INT) AS FinishPosition,
       CAST(r.points AS DECIMAL(5,2)) AS Points,
       CAST(r.laps AS INT) AS LapsCompleted,
       CAST(r.milliseconds AS BIGINT) AS RaceTimeMs,
       F1_DWH.dbo.fn_DoiThoiGianSangMs(r.fastestLapTime) AS FastestLapTimeMs,
       CAST(CASE WHEN r.position = 1  THEN 1 ELSE 0 END AS TINYINT) AS IsWin,
       CAST(CASE WHEN r.position &lt;= 3 THEN 1 ELSE 0 END AS TINYINT) AS IsPodium,
       CAST(CASE WHEN ds.StatusGroup = N'Không hoàn thành' THEN 0 ELSE 1 END AS TINYINT) AS IsFinished
FROM dbo.results r
JOIN dbo.races ra                     ON ra.raceId        = r.raceId
JOIN F1_DWH.dbo.DimRace dr            ON dr.RaceID        = r.raceId
JOIN F1_DWH.dbo.DimCircuit dc         ON dc.CircuitID     = ra.circuitId
JOIN F1_DWH.dbo.DimDriver dd          ON dd.DriverID      = r.driverId
JOIN F1_DWH.dbo.DimConstructor dk     ON dk.ConstructorID = r.constructorId
JOIN F1_DWH.dbo.DimStatus ds          ON ds.StatusID      = r.statusId</property>
