                  name="Nguon FactPitStop"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">-- pit_stops không có đội đua: lấy đội của tay đua ở chặng đó từ bảng results
WITH doi AS (SELECT raceId, driverId, MIN(constructorId) AS constructorId
             FROM dbo.results GROUP BY raceId, driverId)
SELECT CAST(YEAR(ra.[date]) * 10000 + MONTH(ra.[date]) * 100 + DAY(ra.[date]) AS INT) AS DateKey,
       dr.RaceKey, dc.CircuitKey, dd.DriverKey, dk.ConstructorKey,
       CAST(p.[stop] AS INT) AS StopNumber,
       CAST(p.lap AS INT) AS LapNumber,
       CAST(p.milliseconds AS INT) AS DurationMs
FROM dbo.pit_stops p
JOIN dbo.races ra                 ON ra.raceId        = p.raceId
JOIN doi t                        ON t.raceId         = p.raceId AND t.driverId = p.driverId
JOIN F1_DWH.dbo.DimRace dr        ON dr.RaceID        = p.raceId
JOIN F1_DWH.dbo.DimCircuit dc     ON dc.CircuitID     = ra.circuitId
JOIN F1_DWH.dbo.DimDriver dd      ON dd.DriverID      = p.driverId
JOIN F1_DWH.dbo.DimConstructor dk ON dk.ConstructorID = t.constructorId</property>
                    <property
