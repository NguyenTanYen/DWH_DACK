                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT CAST(YEAR(ra.[date]) * 10000 + MONTH(ra.[date]) * 100 + DAY(ra.[date]) AS INT) AS DateKey,
       dr.RaceKey, dd.DriverKey,
       CAST(s.position AS INT) AS StandingPosition,
       CAST(s.points AS DECIMAL(6,2)) AS TotalPoints,
       CAST(s.wins AS INT) AS TotalWins
FROM dbo.driver_standings s
JOIN dbo.races ra            ON ra.raceId   = s.raceId
JOIN F1_DWH.dbo.DimRace dr   ON dr.RaceID   = s.raceId
JOIN F1_DWH.dbo.DimDriver dd ON dd.DriverID = s.driverId</property>
                    <property
