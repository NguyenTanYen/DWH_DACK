                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH so AS (SELECT TOP (27394) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS i
            FROM sys.all_objects a CROSS JOIN sys.all_objects b),
     ngay AS (SELECT DATEADD(DAY, i, CAST('1950-01-01' AS DATE)) AS d FROM so)
SELECT CAST(YEAR(d) * 10000 + MONTH(d) * 100 + DAY(d) AS INT) AS DateKey,
       d                                    AS FullDate,
       CAST(DAY(d) AS TINYINT)              AS [Day],
       CAST(MONTH(d) AS TINYINT)            AS [Month],
       CAST(DATEPART(QUARTER, d) AS TINYINT) AS [Quarter],
       CAST(YEAR(d) AS SMALLINT)            AS [Year],
       CAST(CAST(YEAR(d) / 10 * 10 AS NVARCHAR(4)) + N's' AS NVARCHAR(10)) AS Decade
FROM ngay</property>
