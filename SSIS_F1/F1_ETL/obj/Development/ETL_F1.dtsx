          SQLTask:SqlStatementSource="-- Xoá dữ liệu cũ trong kho (bảng sự kiện trước, bảng chiều sau) để nạp lại từ đầu&#xA;DELETE FROM dbo.FactRaceResult;&#xA;DELETE FROM dbo.FactQualifying;&#xA;DELETE FROM dbo.FactLapTime;&#xA;DELETE FROM dbo.FactPitStop;&#xA;DELETE FROM dbo.FactDriverStanding;&#xA;DELETE FROM dbo.DimDate;&#xA;DELETE FROM dbo.DimRace;        DBCC CHECKIDENT ('dbo.DimRace', RESEED, 0);&#xA;DELETE FROM dbo.DimCircuit;     DBCC CHECKIDENT ('dbo.DimCircuit', RESEED, 0);&#xA;DELETE FROM dbo.DimDriver;      DBCC CHECKIDENT ('dbo.DimDriver', RESEED, 0);&#xA;DELETE FROM dbo.DimConstructor; DBCC CHECKIDENT ('dbo.DimConstructor', RESEED, 0);&#xA;DELETE FROM dbo.DimStatus;      DBCC CHECKIDENT ('dbo.DimStatus', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
