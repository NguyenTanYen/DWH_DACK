  <MdxScripts>
    <MdxScript>
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
  <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
Lệnh CALCULATE điều khiển việc tổng hợp các ô lá của khối – không xoá.
*/
CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Ti Le Thang]
 AS IIF([Measures].[So Luot Dua] = 0, NULL, [Measures].[So Lan Thang] / [Measures].[So Luot Dua]),
FORMAT_STRING = "Percent", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Ket Qua Dua';
CREATE MEMBER CURRENTCUBE.[Measures].[Ti Le Hoan Thanh]
 AS IIF([Measures].[So Luot Dua] = 0, NULL, [Measures].[So Lan Hoan Thanh] / [Measures].[So Luot Dua]),
FORMAT_STRING = "Percent", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Ket Qua Dua';
CREATE MEMBER CURRENTCUBE.[Measures].[Thoi Gian Vong TB Giay]
 AS IIF([Measures].[So Vong] = 0, NULL, [Measures].[Tong Thoi Gian Vong Ms] / [Measures].[So Vong] / 1000),
FORMAT_STRING = "#,##0.000", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Vong Dua';
CREATE MEMBER CURRENTCUBE.[Measures].[Thoi Gian Pit TB Giay]
 AS IIF([Measures].[So Lan Vao Pit] = 0, NULL, [Measures].[Tong Thoi Gian Pit Ms] / [Measures].[So Lan Vao Pit] / 1000),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Vao Pit';</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
